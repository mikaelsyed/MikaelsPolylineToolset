<controls:ProWindow x:Class="MikaelsPolylineToolset.VertexConditioning.VertexConditioningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Recondition Polyline Vertices" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Fixes polyline vertex spacing (min/max distance) and enforces a monotonically non-increasing elevation profile from start to end, sampled from a DEM. Spacing is fixed by resampling along the line's own path; elevation violations are fixed by moving the offending vertex to a nearby DEM cell within the search radius. Start/end vertices are never moved, to protect junction connectivity. Preview first, then Apply."/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Input Polyline Layer:"/>
        <ComboBox x:Name="LineLayerCombo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6"/>

        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Input DEM Raster:"/>
        <ComboBox x:Name="RasterLayerCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6"/>

        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Min Vertex Spacing (map units):"/>
        <TextBox x:Name="MinSpacingTextBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="1.5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Max Vertex Spacing (map units):"/>
        <TextBox x:Name="MaxSpacingTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="3"/>

        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,8,6" Text="Elevation Fix Search Radius (map units):"/>
        <TextBox x:Name="SearchRadiusTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,6" Text="5"/>

        <CheckBox x:Name="SelectedOnlyCheck" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,6"
                  Content="Process only selected features (unchecked = entire layer)"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Margin="0,0,0,6" FontStyle="Italic"
                   Text="Preview computes the changes and selects the polylines that need review, without touching the data. Apply writes the previewed changes as one undoable edit operation."/>

        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,4" Text="Log:"/>
        <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="1">
            <wfi:WindowsFormsHost x:Name="LogHost"/>
        </Border>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PreviewButton" Content="Preview" Width="90" Padding="4" Margin="0,0,8,0" Click="PreviewButton_Click" IsDefault="True"/>
            <Button x:Name="ApplyButton" Content="Apply" Width="90" Padding="4" Margin="0,0,8,0" Click="ApplyButton_Click" IsEnabled="False"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Padding="4" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</controls:ProWindow>
